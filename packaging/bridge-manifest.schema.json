{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mengzeovo/zotero-agent-bridge/schemas/bridge-manifest-v1.json",
  "title": "Zotero Agent Bridge XPI Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "bridge_version",
    "protocol_version",
    "distribution",
    "platform",
    "architecture",
    "entrypoint",
    "sentinel",
    "build",
    "files"
  ],
  "properties": {
    "bundle_schema_version": { "const": 1 },
    "bridge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "protocol_version": { "type": "integer", "const": 1 },
    "distribution": { "const": "xpi-bundled" },
    "platform": { "const": "windows" },
    "architecture": { "const": "x64" },
    "entrypoint": { "$ref": "#/$defs/relativePath" },
    "sentinel": { "const": ".zab-bundle-installed.json" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "pyinstaller_version", "built_at", "source_revision"],
      "properties": {
        "python_version": { "type": "string", "minLength": 1 },
        "pyinstaller_version": { "type": "string", "minLength": 1 },
        "built_at": { "type": "string", "format": "date-time" },
        "source_revision": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
